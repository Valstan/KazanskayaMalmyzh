# /etc/kazanskaya/kazanskaya.env — прод-секреты вне репо (#008).
# В git — только этот пример.

# Отдельная БД и роль на общем PG-инстансе бокса (kickoff §4)
DATABASE_URL=postgresql://kazanskaya_app:CHANGE_ME@localhost:5432/kazanskaya

PAYLOAD_SECRET=CHANGE_ME_32_RANDOM_CHARS

# Порт второго жильца (у Сабантуя :3000)
PORT=3001
HOSTNAME=127.0.0.1

# Боевой домен — строго punycode (G133/G134)
NEXT_PUBLIC_SERVER_URL=https://xn--80aaa0andu6a3j.xn--80adkdyec4j.xn--p1ai

# Персистентное медиа вне релиз-директории (G146)
MEDIA_DIR=/home/valstan/kazanskaya/shared/media

# ── Вход через ЕСА («Сервисы Малмыжа»), пилот #386 ──────────────────────────
#
# client_secret (ESA_CLIENT_SECRET) выдаёт Сарафан и держит в комнате
# КАРМАНА `kazanskayamalmyzh` (grant id=16). Сайт тянет его сам при первом
# обращении, поэтому в этом файле его НЕТ и класть его руками не нужно:
# значение в env-файле юнита — это копия, комната — источник (письмо brain
# 13.10, D-061).
#
# ⚠️ Если всё-таки задать ESA_CLIENT_SECRET здесь, он победит комнату: сайт
# не пойдёт за значением и будет проверять токены подписанным вами секретом.
# Токены ЕСА подписаны RS256, секретом клиента они не проверяются — вход
# перестанет работать. Поэтому placeholder вида CHANGE_ME здесь опасен, и его
# нет намеренно.
ESA_CLIENT_ID=kazanskaya
ESA_ISSUER=https://xn--b1ae3a1a.xn--80adkdyec4j.xn--p1ai

# ─── Комната секретов КАРМАНа (vault) ───────────────────────────────────────
# Нужны только для секретов ЧУЖОГО выпуска — тех, что другой проект положил в
# нашу комнату по grant'у. Для них комната — источник, а prod-env — кэш, который
# может быть пуст (амendment спеки vault-client 03.09, D-061). Клиент —
# src/lib/auth/vault.ts: в норме ноль сетевых вызовов.
# ⚠️ Якорь: новый секрет чужого выпуска сюда → добавить и в allowlist ACCEPTED.
#
# Токен НАШЕЙ комнаты `kazanskayamalmyzh`. На проде лежит в prod-env, в GitHub
# Secrets его нет и быть не должно. **Пусто — до-тяг молча не работает: сайт
# цел, но `/api/auth/esa/login` отвечает `auth=unavailable`** (проверено 06.11).
# Диагностика за минуту — см. docs/BOX_ACCESS.md §Комната КАРМАНа в юните.
# SECRETS_TOKEN=
# Адрес КАРМАНа: база (https://<хост>) или полный метод. Хост в репо не держим
# (D-038) — значение в prod-env; дефолта в коде нет намеренно.
# SECRETS_VAULT_URL=https://<хост>/api/secrets
